# Google Gemini API Key (Required for AI Architecture Summary and Codebase Q&A)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini Model override (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optional: GitHub Personal Access Token to raise GitHub API rate limits
# GITHUB_TOKEN=your_github_token_here

# Server Port (defaults to 5000)
# PORT=5000
